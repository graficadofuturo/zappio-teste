{
  "rewrites": [
    {
      "source": "/api/((?!index).*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/collect-offers",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/process-campaigns",
      "schedule": "* * * * *"
    }
  ]
}
