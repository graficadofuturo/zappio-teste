{
  "manifest_version": 3,
  "name": "Zappio Sync",
  "version": "1.2.0",
  "description": "Sincroniza automaticamente seus cookies de afiliado do Mercado Livre e do AliExpress com o painel do Zappio.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "*://*.mercadolivre.com.br/*",
    "*://*.aliexpress.com/*",
    "http://localhost:3000/*",
    "https://zappio-teste.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
